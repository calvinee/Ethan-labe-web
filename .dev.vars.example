# Copy this file to .dev.vars for local development only.
# Never commit the real API key.
RESEND_API_KEY=re_replace_with_local_test_key
EMAIL_FROM="时工的半导体实验室 <noreply@mailer.example.com>"

# Returns one-time tokens in local API responses and skips external delivery.
# The Worker only honors this switch on localhost / 127.0.0.1.
EMAIL_DEBUG_CAPTURE=true
